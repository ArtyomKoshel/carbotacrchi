# PARSER_ANOMALY_MAX_BYTES=10485760
# PARSER_ANOMALY_MAX_LINES=200000

BATCH_SIZE=100
REQUEST_DELAY=2.0

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
