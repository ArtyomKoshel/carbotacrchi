DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=auction_bot
DB_USERNAME=carbot
DB_PASSWORD=carbot_pass

KBCHA_ENABLED=true
KBCHA_INTERVAL_MINUTES=60
KBCHA_WORKERS=10
KBCHA_MAX_PAGES=1

ENCAR_ENABLED=false
ENCAR_INTERVAL_MINUTES=30
ENCAR_WORKERS=5

USD_KRW_RATE=1350
