APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_DATABASE=auction_bot
DB_USERNAME=carbot
DB_PASSWORD=carbot_pass
MYSQL_ROOT_PASSWORD=root_pass

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

ADMIN_TOKEN=change_me_secret
PARSER_LOG_FILE=/app/logs/parser.log
PARSER_SOURCES=kbcha

# Lot lifecycle (parser delist + lots:lifecycle); counted in successful full runs, not days
LOTS_LIFECYCLE_MIN_COVERAGE=85
LOTS_PURGE_AFTER_RUNS=5

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=480

FLOPPYDATA_API_KEY=
