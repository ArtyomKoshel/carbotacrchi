# Copy to docker/dev/.env (not committed). Paths are relative to docker/dev or absolute.
# Which checkout the web container serves. ../.. = the checkout this file is in;
# from the main checkout, a worktree: ../../.claude/worktrees/<name>
CARBOT_SRC=../..
# true = run schedule:work (ingest:consume, lifecycle, notifications) like prod
DEV_SCHEDULER=false
