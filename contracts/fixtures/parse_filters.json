        {
            "case": "int_gt",
            "form": {"phase": "pre", "action": "skip", "field": "mileage", "operator": "gt", "value_number": "200000", "scope": "this"},
            "row": {"source": "encar", "field": "mileage", "operator": "gt", "value": "200000", "action": "skip", "phase": "pre", "rule_group_id": null},
            "lots": [
                {"lot": {"mileage": 250000}, "matches": true},
                {"lot": {"mileage": 200000}, "matches": false},
                {"lot": {"mileage": 150000}, "matches": false}
            ]
        },
