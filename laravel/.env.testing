# Loaded when APP_ENV=testing (php artisan test, vendor/bin/phpunit). No secrets:
# every value is a placeholder, and the database is a local throw-away one.
# phpunit.xml forces the same values; Tests\TestCase refuses any other DB.
APP_NAME=CarBot
APP_ENV=testing
APP_KEY=base64:dGVzdC1rZXktZm9yLWNhcmJvdC10ZXN0cy0zMmJ5dGU=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3318
DB_DATABASE=carbot_test
DB_USERNAME=carbot
DB_PASSWORD=carbot

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=null
